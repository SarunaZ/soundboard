{
  "name": "soundboard",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "shared",
    "service",
    "app-client",
    "app-play",
    "worker"
  ],
  "resolutions": {
    "@xmldom/xmldom@npm:^0.8.8": "npm:0.8.15",
    "@xmldom/xmldom@npm:^0.9.10": "npm:0.9.12",
    "body-parser@npm:^2.2.1": "npm:2.4.0",
    "brace-expansion@npm:^5.0.8": "npm:5.0.12",
    "compression@npm:^1.7.4": "npm:1.8.2",
    "image-size@npm:^1.0.2": "npm:2.0.3",
    "js-yaml@npm:^4.1.0": "npm:4.3.2",
    "metro@npm:0.84.4": "patch:metro@npm%3A0.84.4#./.yarn/patches/metro-npm-0.84.4-security.patch",
    "metro@npm:^0.84.3": "patch:metro@npm%3A0.84.4#./.yarn/patches/metro-npm-0.84.4-security.patch",
    "node-forge@npm:^1.3.3": "patch:node-forge@npm%3A1.4.0#./.yarn/patches/node-forge-npm-1.4.0-security.patch",
    "proxy-addr@npm:^2.0.7": "npm:2.0.8",
    "qs@npm:^6.14.0": "npm:6.16.1",
    "qs@npm:^6.15.2": "npm:6.16.1",
    "sharp@npm:0.35.2": "npm:0.35.5",
    "shell-quote@npm:^1.6.1": "npm:1.11.0",
    "source-map-js@npm:^1.2.1": "npm:1.2.2",
    "undici@npm:7.29.0": "npm:7.30.1",
    "undici@npm:^8.4.1": "npm:8.12.2",
    "uuid@npm:^7.0.3": "npm:11.1.1",
    "zod@npm:^3.25.76": "npm:4.6.6"
  },
  "engines": {
    "node": ">=24"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  },
  "scripts": {
    "install:nobuild": "yarn install --mode=skip-build",
    "build": "yarn workspace @soundboard/shared build && yarn workspace @soundboard/service build",
    "test:play-stage": "node --test scripts/verify-play-stage.test.mjs scripts/play-release-plugin.test.cjs"
  }
}
