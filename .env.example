# Copy to .env — .env is gitignored and never enters the image.

# Your machine's LAN address, e.g. 192.168.1.42. Metro runs in a container, so
# without this it advertises a container IP the phone cannot reach.
LAN_IP=

# Cloudflare R2 (PLAN §2). Private bucket with content-addressed keys; public
# reads go through the read-only soundboard-media Worker.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=soundboard
# The public Worker base URL the phone fetches clips from. Never use the R2
# bucket endpoint here.
R2_PUBLIC_BASE_URL=

# Static bearer token for GET /manifest (DESIGN §12). Single user; the app
# ships with this baked in. Not a real auth system and not pretending to be.
MANIFEST_TOKEN=
