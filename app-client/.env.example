# Copy to .env.local. The local file is gitignored.
#
# This is the public, immutable manifest endpoint on the Cloudflare Worker,
# never an R2 API endpoint, bucket hostname, access key, or secret.
EXPO_PUBLIC_MANIFEST_URL=https://soundboard-media.sarunas-zube.workers.dev/manifest/v1.json

# Temporary personal editor API. On Android development builds run
# `adb reverse tcp:8080 tcp:8080` to use the local service at this address.
# Set the token to the same value as EDITOR_TOKEN in the root .env file.
# This token is bundled into the private app; it is not production auth.
EXPO_PUBLIC_EDITOR_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_EDITOR_TOKEN=
